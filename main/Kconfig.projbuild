menu "UWatch configuration"

config UWATCH_TIMEZONE
    string "Local POSIX timezone"
    default "CET-1CEST-2,M3.5.0/2,M10.5.0/3"
    help
        POSIX TZ string used to convert the UTC hardware clock to local time
        for display, alarms, night mode, and local-date logs. For example,
        use UTC0 for UTC without daylight-saving transitions.

endmenu
